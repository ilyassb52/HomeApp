# Modèle du fichier .env. Le copier en .env, puis changer le mot de passe.
# Le fichier .env lui-même n'est jamais commité (voir .gitignore).

POSTGRES_USER=mirror
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=mirror

# Adresse de l'API vue par le serveur Next.js (proxy /backend, voir
# web/next.config.ts). Facultatif : c'est déjà la valeur par défaut.
# API_URL=http://localhost:8000
